        <com:Extension Category="windows.comServer" uap10:RuntimeBehavior="packagedClassicApp">
          <com:ComServer>
            <com:SurrogateServer DisplayName="OtterZip Shell Extension">
              <!-- 22…: ExtractHereCommand
                   44…: CompressCommand (the legacy dialog-flow verb,
                                        now relabelled "OtterZip으로
                                        압축…(&O)" — opens MainWindow)
                   33…: OtterzipMenuCommand (parent submenu, nested
                                            mode only)
                   55…: CompressZipQuickCommand   (Bandizip-style direct
                                                  ".zip으로 압축(&Z)")
                   66…: CompressSevenZQuickCommand (".7z으로 압축(&7)")
                   New 55/66 CLSIDs are registered for the same DLL —
                   one factory per verb because IExplorerCommand carries
                   the verb identity in the canonical name. -->
              <com:Class Id="e60e719c-1cbb-4651-a374-eff2d5ddde9b"
                         Path="OtterZip.Shell.dll"
                         ThreadingModel="STA" />
              <com:Class Id="a5927606-6461-438c-81a2-e1205640d703"
                         Path="OtterZip.Shell.dll"
                         ThreadingModel="STA" />
              <com:Class Id="81df37ed-1fd3-4e3a-8cf2-d5f8bfb644b8"
                         Path="OtterZip.Shell.dll"
                         ThreadingModel="STA" />
              <com:Class Id="d38f2276-845d-499d-8311-3c9c9ba692d3"
                         Path="OtterZip.Shell.dll"
                         ThreadingModel="STA" />
              <com:Class Id="48492b43-300e-41a2-9392-356f3debc2f5"
                         Path="OtterZip.Shell.dll"
                         ThreadingModel="STA" />
              <!-- 2026-05-19 sprint: 4-context Bandizip parity verbs.
                   77…: ExtractSmartCommand        ("알아서 풀기(&Z)")
                   88…: ExtractToSubfolderCommand  ("<stem>\에 풀기(&E)")
                   99…: ExtractDialogCommand       ("OtterZip으로 풀기...(&B)")
                   AAA…: CompressIndividuallyCommand ("각 항목별 압축(&U)")
              -->
              <com:Class Id="c3dd0de3-e7bf-482c-bb51-67be5a79a72f"
                         Path="OtterZip.Shell.dll"
                         ThreadingModel="STA" />
              <com:Class Id="5bec639c-b9f1-4aec-906d-4a308df13511"
                         Path="OtterZip.Shell.dll"
                         ThreadingModel="STA" />
              <com:Class Id="9bda144d-ce5b-4d18-aa5d-bed7970aec5b"
                         Path="OtterZip.Shell.dll"
                         ThreadingModel="STA" />
              <com:Class Id="fc32ea28-1809-481c-b71e-d84b61229da0"
                         Path="OtterZip.Shell.dll"
                         ThreadingModel="STA" />
              <!-- 2026-06-18: bbb… OpenAppCommand ("OtterZip 열기") —
                   empty-space (Directory\Background) launch verb. -->
              <com:Class Id="ad0f669b-3701-40c6-87b2-0aacc445dff7"
                         Path="OtterZip.Shell.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

        <!--
          Phase 7+ (Bandizip mainstream 호환): ItemType 확장.
          schema.md §1.1 ArchiveFormat enum의 추출 가능 포맷 전체 등록.
          ZIP 변종 (JAR/WAR/IPA/APK/APPX/XPI 등) 및 TAR alias (TGZ/TBZ/TLZ/TXZ)는
          enum 추가 없이 detect.rs의 확장자 매핑으로 처리되지만, Explorer 우클릭
          노출을 위해 매니페스트엔 명시 등록 필요.
          OUT 포맷 (schema.md §1.1.1)은 등록하지 않음 — Explorer가 자동으로
          제외 표시.
        -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <!--
                Bandizip-style direct format-specific quick verbs
                (commit 6 of the quick-compress sprint). Both hide
                themselves when Settings_ShellMenuMode == "nested" so
                the layouts never double-render with OtterzipMenu.
              -->
              <desktop5:Verb Id="OtterzipCompressZip"
                             Clsid="d38f2276-845d-499d-8311-3c9c9ba692d3" />
              <desktop5:Verb Id="OtterzipCompress7z"
                             Clsid="48492b43-300e-41a2-9392-356f3debc2f5" />
              <desktop5:Verb Id="OtterzipCompressIndividually"
                             Clsid="fc32ea28-1809-481c-b71e-d84b61229da0" />
              <desktop5:Verb Id="OtterzipCompress"
                             Clsid="a5927606-6461-438c-81a2-e1205640d703" />
              <!--
                Parent menu verb. Visible only when ShellMenuMode is
                "nested"; in flat mode OtterzipMenuCommand.GetState
                hides itself. Conversely Compress / Extract hide
                themselves at top level when nested mode is on, so the
                two layouts never double-render.
              -->
              <desktop5:Verb Id="OtterzipMenu"
                             Clsid="81df37ed-1fd3-4e3a-8cf2-d5f8bfb644b8" />
            </desktop5:ItemType>

            <!--
              Folder right-click (a folder is SELECTED, right-clicked
              from its parent): same compress verbs as file right-click,
              minus Extract (folders aren't archives). ExtractHere is
              intentionally omitted from Directory — nothing to extract
              from a folder.

              `Directory\Background` (right-click the EMPTY SPACE inside
              a folder) deliberately does NOT carry the compress verbs —
              "compress the current folder" from its own background is a
              self-referential action Bandizip doesn't offer either. It
              carries ONLY the "새 폴더 / New folder" verb (user request
              2026-06-18, reversing the 2026-06-17 "no background verb"
              decision). Windows 11 still shows its own native "새 폴더(N)"
              at the top; this is the OtterZip-branded equivalent in the
              OtterZip group lower in the menu.
            -->
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="OtterzipCompressZip"
                             Clsid="d38f2276-845d-499d-8311-3c9c9ba692d3" />
              <desktop5:Verb Id="OtterzipCompress7z"
                             Clsid="48492b43-300e-41a2-9392-356f3debc2f5" />
              <desktop5:Verb Id="OtterzipCompressIndividually"
