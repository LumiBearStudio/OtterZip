        </desktop4:Extension>
      </Extensions>

    </Application>
  </Applications>

  <Capabilities>
    <!-- runFullTrust ONLY — mirrors NanaZip (same packaged shell-extension
         architecture, Store-published). The restricted virtualization-escape
         capability was removed 2026-07-13: it had been added 2026-05-15 as a
         guess while diagnosing a verb-registration silent-fail whose real
         cause turned out to be the Application activation attributes; nothing
         in the app or shell DLL escapes MSIX virtualization (settings/cache
         live in the package's own ApplicationData), and Store certification
         10.6.3 denied the capability request. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
