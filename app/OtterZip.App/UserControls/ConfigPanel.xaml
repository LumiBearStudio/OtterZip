<?xml version="1.0" encoding="utf-8"?>
<!--
  ConfigPanel — Concept C canvas + chip overlays as siblings.

  Critical: the chips MUST NOT be children of the DropHintCard Border —
  pointer Tapped events bubble in WinUI, so a chip click would also
  fire DropHintCard.Tapped and open the file picker behind the flyout.
  By making the chip stacks siblings of DropHintCard inside the outer
  Grid, hit-testing sees the chips first and Tapped on the canvas only
  fires when the user actually clicks the empty drop area.

  Layout (logical):
    ┌────────────────────────────────────────────┐ ← DropHintCard (Tapped)
    │ [📄 ZIP ▾]  [압축 옵션 ▾]            [⚙]   │ ← chip overlay row
    │              🐚                            │
    │   파일을 끌어다 놓으세요                   │
    │   또는 클릭해서 직접 선택                  │
    └────────────────────────────────────────────┘

  Hard rules:
    - All user-visible text via x:Uid → .resw keys
    - All colors via {ThemeResource ...}
-->
<UserControl
    x:Class="OtterZip.App.UserControls.ConfigPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="ConfigPanel_Region">

    <Grid Margin="12">

        <!-- The drop canvas Border. Its Tapped opens the file picker
             when the user clicks empty space. Children = the centered
             mascot stack ONLY — the chips live as Grid siblings below. -->
        <Border x:Name="DropHintCard"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Tapped="OnDropHintTapped">
            <!-- icon + title + subtitle are one group, centered as a unit.
                 No bottom margin: a margin would be folded into the centering
                 box and push the whole group visibly upward. -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        Padding="20,20,20,20">
                <Image Source="ms-appx:///Assets/ShellMascot.png"
                       Width="64" Height="64"
                       Opacity="0.9"
                       Margin="0,0,0,2"
                       HorizontalAlignment="Center" />
                <TextBlock x:Uid="ConfigPanel_DropHintTitle"
                           Style="{StaticResource BodyStrongTextStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <TextBlock x:Uid="ConfigPanel_DropHintSubtitle"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Top-left chip group: Format + Compress options. Sibling of
             DropHintCard so clicks here don't bubble into the canvas
             Tapped handler. -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="12"
                    Spacing="6">
            <ComboBox x:Name="FormatCombo"
                      SelectedIndex="0"
                      MinWidth="116"
                      SelectionChanged="OnFormatChanged">
                <ComboBoxItem x:Uid="ConfigPanel_FormatZip" Tag="ZIP" />
                <ComboBoxItem x:Uid="ConfigPanel_FormatSevenZ" Tag="7z" />
                <ComboBoxItem x:Uid="ConfigPanel_FormatTar" Tag="tar" />
                <ComboBoxItem x:Uid="ConfigPanel_FormatTarGz" Tag="tar.gz" />
                <ComboBoxItem x:Uid="ConfigPanel_FormatXz" Tag="xz" />
                <ComboBoxItem x:Uid="ConfigPanel_FormatZipx" Tag="zipx" />
            </ComboBox>

            <DropDownButton x:Name="CompressOptionsButton"
                            x:Uid="ConfigPanel_CompressOptionsButton"
                            MinHeight="32">
                <DropDownButton.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft"
                            ShouldConstrainToRootBounds="False">
                        <StackPanel Width="320"
                                    Spacing="14">

                            <!-- Split into volumes (.001/.002…). In the
                                 "압축 옵션" flyout next to password — off the
                                 simple main surface, but available when wanted.
                                 7z / ZIP only (disabled for other formats by
                                 ApplyFormatConstraints). Custom size lives in
                                 the full right-click options dialog. -->
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                              Glyph="&#xE8C6;"
                                              FontSize="12"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource OtterzipBrandBrush}" />
                                    <TextBlock x:Uid="ConfigPanel_SplitLabel"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <ComboBox x:Name="SplitCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectedIndex="0"
                                          SelectionChanged="OnSplitChanged">
                                    <ComboBoxItem x:Uid="ConfigPanel_SplitNone" Tag="0" />
                                    <ComboBoxItem x:Uid="ConfigPanel_Split10Mb" Tag="10485760" />
                                    <ComboBoxItem x:Uid="ConfigPanel_Split100Mb" Tag="104857600" />
                                    <ComboBoxItem x:Uid="ConfigPanel_Split700Mb" Tag="734003200" />
                                    <ComboBoxItem x:Uid="ConfigPanel_Split1Gb" Tag="1073741824" />
                                    <ComboBoxItem x:Uid="ConfigPanel_Split47Gb" Tag="5046586573" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Password + AES-256 -->
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                              Glyph="&#xE192;"
                                              FontSize="12"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource OtterzipBrandBrush}" />
                                    <TextBlock x:Uid="ConfigPanel_PasswordLabel"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox Grid.Column="0"
                                                 x:Name="PasswordInput"
                                                 x:Uid="ConfigPanel_PasswordPlaceholder"
                                                 PasswordChanged="OnPasswordChanged" />
                                    <ToggleButton Grid.Column="1"
                                                  x:Name="RevealButton"
                                                  x:Uid="ConfigPanel_PasswordRevealButton"
                                                  Style="{StaticResource IconToggleButtonStyle}"
                                                  MinWidth="32" MinHeight="32"
                                                  Padding="4"
                                                  Checked="OnRevealToggled"
                                                  Unchecked="OnRevealToggled">
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                  Glyph="&#xE7B3;"
                                                  FontSize="{StaticResource IconSizeS}" />
                                    </ToggleButton>
                                </Grid>
                                <!-- Password ZIPs are always AES-256 (fail-
                                     closed core) — the old toggle here was
                                     wired to nothing and implied a ZipCrypto
                                     fallback that doesn't exist. Replaced by
                                     an Explorer-compat heads-up, shown while
                                     a password is set. -->
                                <TextBlock x:Name="AesNoteText"
                                           x:Uid="ConfigPanel_AesNote"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>

                            <!-- Bottom checkboxes -->
                            <StackPanel Spacing="2">
                                <StackPanel>
                                    <CheckBox x:Name="ExcludeMetaCheck"
                                              x:Uid="ConfigPanel_ExcludeSystemMeta"
                                              MinHeight="0"
                                              Tag="Settings_ExcludeSystemMetadata"
                                              Checked="OnAdvancedToggle"
                                              Unchecked="OnAdvancedToggle" />
                                    <TextBlock x:Uid="ConfigPanel_ExcludeSystemMetaSub"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Margin="28,0,0,2"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <CheckBox x:Name="VerifyCheck"
                                          x:Uid="ConfigPanel_VerifyAfterCompress"
                                          MinHeight="0"
                                          Tag="Settings_VerifyAfterCompress"
                                          Checked="OnAdvancedToggle"
                                          Unchecked="OnAdvancedToggle" />
                                <CheckBox x:Name="DeleteSourceCheck"
                                          x:Uid="ConfigPanel_DeleteSourceAfter"
                                          MinHeight="0"
                                          Tag="Settings_DeleteSourceAfterCompress"
                                          Checked="OnAdvancedToggle"
                                          Unchecked="OnAdvancedToggle" />
                                <CheckBox x:Name="SeparatelyCheck"
                                          x:Uid="ConfigPanel_CompressSeparately"
                                          MinHeight="0"
                                          Tag="Settings_CompressSeparately"
                                          Checked="OnAdvancedToggle"
                                          Unchecked="OnAdvancedToggle" />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>

        <!-- Top-right chips: More menu (⋯) + Settings gear (siblings of
             DropHintCard). The More menu surfaces support + sister apps + help
             behind one small icon so the canvas stays clean (no banners); the
             gear keeps direct one-click Settings access. -->
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="12">
            <Button x:Name="MoreChip"
                    Style="{StaticResource IconButtonStyle}"
                    x:Uid="Main_MoreButton"
                    MinWidth="32" MinHeight="32"
                    Padding="0">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem x:Uid="Main_MoreMenu_Support" Click="OnMoreSupport">
                            <MenuFlyoutItem.Icon>
                                <!-- Solid heart (U+2665). The Segoe Fluent 'HeartFill'
                                     glyph rendered as an outline on some machines, so
                                     use the Unicode heart in the text font, which is
                                     reliably filled and themes to the foreground. -->
                                <FontIcon FontFamily="{ThemeResource ContentControlThemeFontFamily}" Glyph="&#x2665;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Main_MoreMenu_SpanFinder" Click="OnMoreSpanFinder" />
                        <MenuFlyoutItem x:Uid="Main_MoreMenu_OtterGif" Click="OnMoreOtterGif" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Main_MoreMenu_Help" Click="OnMoreHelp" />
                    </MenuFlyout>
                </Button.Flyout>
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                          Glyph="&#xE712;"
                          FontSize="{StaticResource IconSizeS}" />
            </Button>
            <Button x:Name="SettingsChip"
                    Style="{StaticResource IconButtonStyle}"
                    x:Uid="Main_SettingsButton"
                    Click="OnSettingsChipClick"
                    MinWidth="32" MinHeight="32"
                    Padding="0">
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                          Glyph="&#xE713;"
                          FontSize="{StaticResource IconSizeS}" />
            </Button>
        </StackPanel>

    </Grid>

</UserControl>
