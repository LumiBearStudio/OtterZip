<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings → Info tab.

  Layout (top-to-bottom):
    1. Hero block       - otter mascot + app name + tagline (centered)
    2. Metadata card    - version / build / copyright in a labeled grid
    3. License buttons  - LICENSE.txt + THIRD-PARTY-NOTICES.md viewers
    4. Unrar notice     - Alexander Roshal RAR-extract licensing footnote
    5. Telemetry block  - opt-in crash report toggle (PR-7F)

  All strings via x:Uid; all colors via {ThemeResource}.
-->
<UserControl
    x:Class="OtterZip.App.Dialogs.InfoSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{StaticResource SpacingLValue}"
                    Padding="{StaticResource SpacingL}">

            <!-- ====================================================== -->
            <!--  1. Hero — otter + app name + tagline                  -->
            <!-- ====================================================== -->
            <StackPanel HorizontalAlignment="Center"
                        Spacing="{StaticResource SpacingSValue}"
                        Margin="0,8,0,0">
                <Image Source="ms-appx:///Assets/Square150x150Logo.png"
                       Width="96"
                       Height="96"
                       HorizontalAlignment="Center" />
                <TextBlock x:Uid="App_WindowTitleLabel"
                           Style="{StaticResource SubtitleTextStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Uid="Settings_Info_Tagline"
                           Style="{StaticResource BodyTextStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- ====================================================== -->
            <!--  2. Metadata card — version / build / copyright        -->
            <!-- ====================================================== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12">
                <Grid ColumnSpacing="{StaticResource SpacingMValue}"
                      RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               x:Uid="Settings_VersionLabel"
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               x:Name="VersionText"
                               Style="{StaticResource BodyStrongTextStyle}"
                               IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               x:Uid="Settings_Info_BuildLabel"
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               x:Name="BuildText"
                               Style="{StaticResource BodyTextStyle}"
                               IsTextSelectionEnabled="True"
                               FontFamily="{ThemeResource MonoFontFamily}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                               x:Uid="Settings_Info_Copyright"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,4,0,0"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
            </Border>

            <!-- ====================================================== -->
            <!--  3. License buttons                                    -->
            <!-- ====================================================== -->
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource SpacingSValue}">
                <Button x:Uid="Settings_OpenLicense" Click="OnOpenLicense" />
                <Button x:Uid="Settings_OpenThirdParty" Click="OnOpenThirdParty" />
            </StackPanel>

            <!-- Re-open the first-run onboarding walkthrough on demand. -->
            <HyperlinkButton x:Uid="Settings_Info_ShowOnboarding"
                             Click="OnShowOnboarding"
                             Margin="0,2,0,0" />

            <!-- Report an issue — opens the GitHub issue board in the default
                 browser. NavigateUri is a fixed config URL (not a localized
                 string); only the label is localized via x:Uid. -->
            <HyperlinkButton x:Uid="Settings_Info_ReportIssue"
                             NavigateUri="https://github.com/LumiBearStudio/OtterZip/issues" />

            <!-- ====================================================== -->
            <!--  4. Unrar notice                                       -->
            <!-- ====================================================== -->
            <TextBlock x:Uid="Settings_UnrarNotice"
                       Style="{StaticResource CaptionTextStyle}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

            <!-- ====================================================== -->
            <!--  5. Telemetry opt-in (PR-7F) — toggle card             -->
            <!-- ====================================================== -->
            <Border Style="{StaticResource CompactCardStyle}" Margin="0,8,0,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingsIconChipStyle}">
                        <FontIcon Glyph="&#xE9D9;" Style="{StaticResource SettingsCardIconStyle}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Uid="Settings_TelemetryEnabled" Style="{StaticResource SettingsCardTitleStyle}" />
                        <TextBlock x:Uid="Settings_TelemetryEnabledSub" Style="{StaticResource SettingsCardDescStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2"
                                  x:Name="TelemetryEnabledCheck"
                                  Style="{StaticResource SettingsCardToggleStyle}"
                                  Toggled="OnTelemetryToggle" />
                </Grid>
            </Border>

            <!-- Privacy policy — surfaced right by the data-collection toggle.
                 Fixed config URL (the same blob the Store listing points at);
                 only the label is localized via x:Uid. -->
            <HyperlinkButton x:Uid="Settings_Info_PrivacyPolicy"
                             NavigateUri="https://github.com/LumiBearStudio/OtterZip/blob/master/PRIVACY.md"
                             Margin="0,2,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
